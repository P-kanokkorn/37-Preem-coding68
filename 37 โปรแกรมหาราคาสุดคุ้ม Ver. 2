# 🎀 โปรแกรมหาราคาสุดคุ้ม พรีม 37 (Cute Pink Edition) 🎀

print("🌸✨ เปรียบเทียบราคาสินค้า 2 ชิ้น ✨🌸")
print("〰️" * 25)

# --- รับข้อมูลชิ้นที่ 1 ---
price_one = float(input("👛 ราคาสินค้าชิ้นที่ 1 (บาท): "))
amount_one = float(input("🍭 ปริมาณสินค้าชิ้นที่ 1 (เช่น กรัม/มล.): "))
worthwhile_one = price_one / amount_one

print(" . ｡ ﾟ ☁️ ﾟ ｡ . ｡ ﾟ ☁️ ﾟ ｡ .")

# --- รับข้อมูลชิ้นที่ 2 ---
price_two = float(input("👛 ราคาสินค้าชิ้นที่ 2 (บาท): "))
amount_two = float(input("🍭 ปริมาณสินค้าชิ้นที่ 2 (เช่น กรัม/มล.): "))
worthwhile_two = price_two / amount_two

print("〰️" * 25)

# แสดงผลราคาต่อหน่วย
print(f"🌷 ความคุ้มค่าชิ้นที่ 1 = {worthwhile_one:.2f} บาท/หน่วย")
print(f"🌷 ความคุ้มค่าชิ้นที่ 2 = {worthwhile_two:.2f} บาท/หน่วย")

print("〰️" * 25)

# เปรียบเทียบ + คำนวณส่วนต่าง
if worthwhile_one < worthwhile_two:
    diff = worthwhile_two - worthwhile_one
    print("💖 สรุป: สินค้าชิ้นที่ 1 คุ้มกว่าค่าา (ถูกกว่า) ✨")
    print(f"   (ถูกกว่ากันอยู่ {diff:.2f} บาท/หน่วย นะคะ 🎀)")

elif worthwhile_one > worthwhile_two:
    diff = worthwhile_one - worthwhile_two
    print("💖 สรุป: สินค้าชิ้นที่ 2 คุ้มกว่าค่าา (ถูกกว่า) ✨")
    print(f"   (ถูกกว่ากันอยู่ {diff:.2f} บาท/หน่วย นะคะ 🎀)")

else:
    print("💕 สรุป: สินค้ามีราคาเท่ากันเป๊ะเลยค่าา 🍬")

print("🌸✨ ขอบคุณที่ใช้งานนะคะ ✨🌸")
